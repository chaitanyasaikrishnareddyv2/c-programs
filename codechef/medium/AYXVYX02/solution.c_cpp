#include <stdio.h>
int main()
{
 int i,j,k,n=10,a[10],c=0;
 for(i=0;i<n;i++)
 {
     scanf("%d",&a[i]);
 }
 for(i=0;i<n;i++)
 {
     for(j=i+1;j<n;j++)
     {
         for(k=j;k<n-1;k++)
         {
             if(a[i]==a[j])
             {
                printf("%d",a[i]); 
                c++;
                break;
             }
         }
     }
 }
 if(c==0)
 {
     printf("No duplicates");
 }

    return 0;
}