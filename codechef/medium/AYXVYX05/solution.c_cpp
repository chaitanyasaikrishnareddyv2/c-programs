#include <stdio.h>

int main() {
    int readings[12];
    int i;

    for (i = 0; i < 12; i++) {
        scanf("%d", &readings[i]);
        if(readings[i]<0)
        {
        readings[i]=0;
        }
    }

    
    for (i = 0; i < 12; i++) {
        printf("%d ", readings[i]);
    }
    printf("\n");

    return 0;
}