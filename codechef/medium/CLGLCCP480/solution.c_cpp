#include <stdio.h>

int main() {
    int matrix[3][3];
    int sum_row = 0, sum_col = 0;

    // Input 9 elements into the matrix (row-wise)
    for (int i = 0; i < 3; i++) {            
        for (int j = 0; j < 3; j++) {
            scanf("%d", &matrix[i][j]); 
            sum_row += matrix[i][j];
        }
    }
    for(int j=0; j<3;j++)
    {
        for(int i = 0;i<3;i++)
        {
            sum_col += matrix[i][j];
        }
    }

    printf("Sum by row-major traversal: %d\n",sum_row);
    printf("Sum by column-major traversal: %d",sum_col);
    // write your code here

    return 0;
}
