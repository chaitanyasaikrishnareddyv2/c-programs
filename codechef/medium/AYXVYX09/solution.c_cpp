#include <stdio.h>

int main() {
    int warehouse[4][4];
    int target;
    int i, j,c;

    for (i = 0; i < 4; i++) {
        for (j = 0; j < 4; j++) {
            scanf("%d", &warehouse[i][j]);
        }
    }

    scanf("%d", &target);
    for(i = 0;i<4;i++)
    {
        for(j = 0;j<4;j++)
        {
            if(target==warehouse[i][j])
            {
                printf("Found at: %d %d",i,j);
                c++;
                break;
            }
        }
    }

    if(c==0)
    {
        printf("Part not found");
    }

    return 0;
}