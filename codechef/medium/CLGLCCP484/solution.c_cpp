#include <stdio.h>

int main() {
    int sum = 0;
    int a[3][3];
  printf("Enter 9 elements:\n");
   for (int i=0;i<3;i++)
   {
       for(int j = 0;j<3;j++)
       {
           scanf("%d",&a[i][j]);
           if(i==j)
           {
           sum=sum+a[i][j];
       }
   }
}
printf("Sum of diagonal elements: %d",sum);
    return 0;
}

