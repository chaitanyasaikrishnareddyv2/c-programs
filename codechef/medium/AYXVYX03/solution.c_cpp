#include <stdio.h>

int main() {
    int scores[15];
    int even_count = 0;
    int odd_count = 0;
    int i;

    for (i = 0; i < 15; i++) {
        scanf("%d", &scores[i]);
        if(scores[i]%2==0)
        {
            even_count++;
        }
        else
        {
            odd_count++;
        }
    }
    
    
        
    

    printf("Even: %d\n", even_count);
    printf("Odd: %d\n", odd_count);

    return 0;
}