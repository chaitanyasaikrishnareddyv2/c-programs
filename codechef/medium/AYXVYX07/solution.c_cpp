#include <stdio.h>

int main() {
    int scores[10];
    int i,l;

    for (i = 0; i < 10; i++) {
        scanf("%d", &scores[i]);
    }
l=scores[0];
for(i=0;i<10;i++)
{
    if(scores[i]>l)
    {
        l=scores[i];
    }
}
    for(i=0;i<10;i++)
    {
        if(scores[i]==l)
        break;
    }

    printf("%d %d\n", i, l);

    return 0;
}