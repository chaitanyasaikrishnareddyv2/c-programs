#include <stdio.h>

int main() {
    int sales[3][3],s;

    // Read the matrix from the user
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            scanf("%d", &sales[i][j]);
        }
    }

    for(int i=0;i<3;i++)
    {
        s=0;
        for(int j = 0;j<3;j++)
        {
            s=s+sales[i][j];
        }
        printf("Sum of row %d: %d\n",i,s);
    }
   for(int j=0;j<3;j++)
   {
       s=0;
       for(int i =0;i<3;i++)
       {
           s=s+sales[i][j];
       }
       printf("Sum of column %d: %d\n",j,s);
   }
   

    return 0;
}
