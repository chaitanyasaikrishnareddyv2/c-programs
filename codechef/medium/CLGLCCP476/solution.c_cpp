#include <stdio.h>

int main() {
    int matrix[3][3];  
    int c = 0;    
    
     for(int i=0;i<3;i++)
     {
         for(int j=0;j<3;j++)
         {
             scanf("%d",&matrix[i][j]);
             if(matrix[i][j]%2==0)
             {
                 c++;
             }
             
         }
     }// write your code here
   printf("Total even numbers: %d",c);
    return 0;
}
