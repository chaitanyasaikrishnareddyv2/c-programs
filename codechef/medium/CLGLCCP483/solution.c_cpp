#include <stdio.h>

int main() {
    // Declare three 3x3 matrices
    int matrixA[3][3], matrixB[3][3], result[3][3];
    
    // Initialize matrixA
    // printf("Enter elements of Matrix A (3x3):\n");
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            scanf("%d", &matrixA[i][j]);
        }
    }
    // Initialize matrixB
    // printf("Enter elements of Matrix B (3x3):\n");
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            scanf("%d", &matrixB[i][j]);
        }
    }
    for(int i = 0;i<3;i++)
    {
        for(int j = 0;j<3;j++)
        {
            result[i][j] = matrixA[i][j]-matrixB[i][j];
        }
    }
    
    
    // Print the result matrix
    printf("Result Matrix:\n");
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            printf("%d ", result[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}

