#include <stdio.h>

// Function declaration
int findMax(int a, int b);

int main() {
    int num1, num2;
    scanf("%d",&num1);
    scanf("%d",&num2);
    int max = findmax(num1 ,num2);
    printf("The maximum number is: %d\n",max);
    
    
    return 0;
}

int findmax(int a ,int b)
{
    if(a>b)
    {
        return a;
    }
    return b;
}