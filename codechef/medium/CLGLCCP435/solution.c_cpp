#include <stdio.h>

// Function to calculate and return area of rectangle
float calculateArea() {
    float length, width;
    
    scanf("%f", &length);
    
    scanf("%f", &width);
    
    return length * width;
}

int main() {
    float area = calculateArea();
    printf("The area of the rectangle is: %.2f\n", area);
    return 0;
}
