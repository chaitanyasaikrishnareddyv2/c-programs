#include <stdio.h>
#include <string.h>

int main() {
    char message[101];
    char d[101];
    scanf("%s", message);

        // --- YOUR CODE HERE ---
       int j=0;
        int len = strlen(message);
        for(int i = 0;i<len;i++)
        {
            if(message[i]>='0'&&message[i]<='9')
            {
                d[j] = message[i];
                j++;
            }
        }
        d[j] = '0';
    int f = 0;
    for(int i=0;i<j;i++)
    {
        f=f*10+(d[i]-'0');
    }
    f=f*2;
        printf("%d",f);
        
        
    

    return 0;
}