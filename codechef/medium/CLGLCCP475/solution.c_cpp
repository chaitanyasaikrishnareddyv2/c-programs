
#include <stdio.h>

int main() {
    int matrix[3][3];
    int sum = 0;
    
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            scanf("%d", &matrix[i][j]);
            sum = sum+matrix[i][j];
        }
    }
    
    /* Missing code here */
    
    printf("Sum of all elements: %d\n", sum);
    
    return 0;
}
