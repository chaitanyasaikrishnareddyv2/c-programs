#include <stdio.h>
#include <string.h>

int main() {
    char email[101];
    scanf("%s", email);

    int atCount = 0;
    int len = strlen(email);

    for(int i = 0;i<len;i++)
    {
        if(email[i] =='@')
        {
            atCount++;
        }
    }
    
    

    // Check for exactly one '@' and ends with ".com"
    if(len>=4&&strcmp(&email[len-4],".com") == 0 && atCount ==1)
    {
        printf("Valid");
    }
    else
    {
        printf("Invalid");
    }
    
    

    return 0;
}
