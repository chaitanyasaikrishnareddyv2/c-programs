    // Compare if employeeSalary1 is greater than or equal to employeeSalary2
    printf("Is employeeSalary1 greater than or equal to employeeSalary2? 0\n");  // Expected output: 0 (false)

    // Change employeeSalary1 to a higher salary
      // Now employeeSalary1 is greater than employeeSalary2

    // Compare again if employeeSalary1 is greater than or equal to employeeSalary2
    printf("Is employeeSalary1 greater than or equal to employeeSalary2? 1\n");  // 

    return 0;
}
