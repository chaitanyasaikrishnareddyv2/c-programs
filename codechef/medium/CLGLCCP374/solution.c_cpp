#include <stdio.h>
#include<string.h>

int main() {
    char id[20];     // To store the full student ID entered by the user
    char dept[3]; 
    // To store the extracted 2-character department code
    
    // Your code goes here
    scanf("%s",id);
    for(int i = 0;i<2;i++)
    {
        dept[i] = id[i+1];
    }
    dept[2] = '\0';
    if(strcmp(dept,"CS") == 0)
    {
        printf("Computer Science Student");
    }
    else
    {
        printf("Other Department");
    }
    return 0;
}
