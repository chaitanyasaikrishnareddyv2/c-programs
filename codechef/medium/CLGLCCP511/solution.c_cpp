#include <stdio.h>

struct Student {
    char name[30];
    int marks;
};

int main() {
    int i;
   struct Student student[5];
   for( i=0;i<5;i++)
   {
       scanf("%s %d",student[i].name,&student[i].marks);
   }
   
       
   
    printf("Students scoring more than 75:\n");
    for ( i = 0;i<5;i++)
    {
        if (student[i].marks>75)
        {
            printf("%s\n",student[i].name);
        }
    }
    
    return 0;
}
