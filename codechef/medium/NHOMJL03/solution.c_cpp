#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char word[101];
    scanf("%s", word);
    int len = strlen(word);

     // --- YOUR CODE HERE ---
    for (int i = 0;i<len;i++)
    {
        if(word[i] == tolower(word[i]))
        {
            word[i]==toupper(word[i]);
        }
        else
        {
            word[i]==tolower(word[i]);
        }
        
    }
    for (int i = len-1;i>=0;i--){
    printf("%c",word[i]);
    }
    
    

    return 0;
}