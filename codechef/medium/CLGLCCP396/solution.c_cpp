#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char str[100];
    
    // Your code goes here
    fgets(str,sizeof(str),stdin);
    int i=0;
    while(i<strlen(str))
    {
        str[i] = toupper(str[i]);
        i++;
    }
    printf("Uppercase string: %s\n",str);
    i=0;
    while(i<strlen(str))
    {
        str[i] = tolower(str[i]);
        i++;
    }
    printf("Lowercase string: %s",str);
    return 0;
}